# GREENLIGHTHOUSE — environment template. Copy to `.env` and fill in.
# Never commit real secrets. `.env*` is gitignored.

# --- App ---
NODE_ENV=development
# Absolute origin for canonical / hreflang / sitemap URLs (Story 1.9).
# Server-only and read at RUNTIME on purpose: a NEXT_PUBLIC_* variable is inlined
# at BUILD time, and the Dockerfile builds without one — so the image would bake
# this localhost value into every canonical tag on the production site.
SITE_URL=http://localhost:3000
# Whether THIS deployment may be crawled. Fails closed: anything other than `true`
# (case-insensitive, trimmed) makes robots.txt disallow everything. Set it to true
# ONLY on production.
# Be clear on what that buys: `Disallow: /` stops CRAWLING, not INDEXATION — a
# staging URL linked from somewhere public can still be listed URL-only. This is
# one layer; real isolation is HTTP auth or a network boundary.
SITE_ALLOW_INDEXING=false

# --- Database (PostgreSQL) — Story 1.2 ---
# In docker-compose the host is the `postgres` service.
DATABASE_URL=postgresql://glh:glh@localhost:5432/greenlighthouse?schema=public

# --- Redis: TWO instances, deliberately. Stories 1.8 / 3.0 / 3.3 / 3.7a ---
# REDIS_URL backs the Next incremental cache AND the RFQ rate-limit counters
# (`rfq:rl:*`, Story 3.7a). It is DISPOSABLE — the project's standing pre-proof
# step empties the CACHE keyspace (`npm run cache:flush`; that script's prefix
# list deliberately SPARES the counters, but a full instance wipe resets them,
# which is accepted: the limiter fails open by design).
#
# TRUSTED-PROXY POLICY (Story 3.7a — the limiter's client identity): production
# must run behind exactly ONE trusted edge that appends (or replaces)
# X-Forwarded-For; the app trusts ONLY the RIGHTMOST entry (IP-validated) and
# ignores every other hop. There is no proxy in this repo — docker-compose as
# shipped is direct-connect, where the header is spoofable and throttling is
# best-effort only. Unset/empty REDIS_URL disables the limiter (fail-open,
# silent — configuration, not outage).
# REDIS_QUEUE_URL backs BullMQ and is DURABLE: FR29 ("no inquiry is ever lost")
# depends on it.
#
# NEVER point these at the same instance. FLUSHALL removes every key in EVERY
# database on the instance — FLUSHDB is the per-database command — so neither a
# distinct DB index nor a key prefix would protect the queue. maxmemory,
# eviction policy and persistence are instance-wide too: the cache eventually
# wants `allkeys-lru` and no persistence, which would evict BullMQ's job hashes.
#
# These are HOST addresses. Inside docker compose the services override them to
# redis://redis:6379 and redis://redis-queue:6379.
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# --- S3-compatible object storage (MinIO in dev) — Stories 4.5 / 2.3 / 3.7 ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=greenlighthouse-media
S3_FORCE_PATH_STYLE=true

# --- ClamAV (attachment scanning) — Story 3.7b ---
# Read by `src/lib/clamav.ts`, which speaks clamd's `zINSTREAM` over a plain TCP
# socket (no dependency). Story 3.7b scans RFQ attachments SYNCHRONOUSLY inside
# `POST /api/rfq`, so the APP is the clamd client — the WORKER never contacts
# clamd at all. Unreachable clamd means attachments are REJECTED (`scanFailed`), never
# stored unscanned; submissions WITHOUT an attachment are unaffected.
#
# These are HOST addresses. Inside docker compose the app/worker services
# override CLAMAV_HOST to the `clamav` service name.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Auth.js (single admin) — Story 4.1 ---
AUTH_SECRET=change-me-generate-a-long-random-string
AUTH_URL=http://localhost:3000

# --- Transactional email (behind BullMQ) — Story 3.3 ---
# EMAIL_PROVIDER selects the transport and NOTHING else branches on it:
#   resend — the real provider: one HTTPS POST to api.resend.com (no SDK).
#   memory — records sends in process. CI uses this: the provider-failure
#            proof must be deterministic and must never leave the machine.
#   log    — prints what WOULD be sent and sends nothing. THE DEV DEFAULT:
#            running the worker locally must never mail real buyers.
# An unknown value logs loudly and falls back to `log` — a typo must never
# crash the worker and must never silently select the real provider.
EMAIL_PROVIDER=log
# Required only by `resend`. With either unset, the notification is skipped,
# `notify:unconfigured` is recorded on the lead, and it is NOT retried (a
# missing variable will still be missing next attempt). The sender's
# confirmation and the stored lead are unaffected — losing an email must
# never cost an inquiry (FR29).
EMAIL_API_KEY=
EMAIL_FROM=
# Where GLH's own notification goes. Read through EXACTLY ONE function
# (`resolveNotifyRecipient` in src/lib/email.ts) so Story 4.8 can repoint it
# at an admin-managed setting without editing the worker.
RFQ_NOTIFY_TO=

# --- Observability (Sentry) — Story 5.6 ---
SENTRY_DSN=

# --- On-demand cache revalidation (Story 1.8) ---
# Shared secret for POST /api/revalidate (x-revalidate-secret header).
# The route FAILS CLOSED when unset. Epic 4 admin mutations will use it.
# MUST be changed: this file is committed, so any value left here is public, and
# the endpoint it guards purges the cache (repeatable calls = unbounded DB load).
REVALIDATE_SECRET=change-me-generate-a-long-random-string

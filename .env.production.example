# GREENLIGHTHOUSE — PRODUCTION environment (docker-compose.prod.yml). Runbook: docs/deploy.md
#
#   cp .env.production.example .env.production   # ON THE SERVER, never committed
#   chmod 600 .env.production
#
# Generate every secret ON THE SERVER with:   openssl rand -hex 32
# Hex on purpose: POSTGRES_PASSWORD is embedded in a connection URL and must never
# need URL-escaping. Never paste these values into chat, tickets or git.
#
# Internal addresses (Postgres, Redis, MinIO, ClamAV) are set by the compose file —
# do NOT add DATABASE_URL / REDIS_URL / S3_ENDPOINT / CLAMAV_HOST here.

# --- Domain & TLS (Caddy) ---
# The CANONICAL host. Must match exactly what visitors see: canonical/hreflang/
# sitemap URLs are built from it, and the RFQ form rejects other origins.
SITE_DOMAIN=www.greenlighthouse.net
# Redirected (301) to the canonical host.
APEX_DOMAIN=greenlighthouse.net
# Let's Encrypt account / expiry notices.
ACME_EMAIL=

# Search engines stay OUT until GO-LIVE (owner-actions §0: content + legal/translation
# reviews done). Anything but "true" ⇒ robots.txt disallows everything.
SITE_ALLOW_INDEXING=false

# --- Secrets (openssl rand -hex 32 — each a DIFFERENT value) ---
POSTGRES_PASSWORD=
MINIO_ROOT_USER=glh-minio
MINIO_ROOT_PASSWORD=
# Admin session signing key (>= 32 bytes, or the app refuses to sign/verify).
AUTH_SECRET=
# Guards POST /api/revalidate (fails closed when unset).
REVALIDATE_SECRET=

# --- Object storage (MinIO on this server, private network only) ---
S3_BUCKET=greenlighthouse-media

# --- Email (Resend) ---
# The production worker REFUSES TO START on a non-delivering transport.
EMAIL_PROVIDER=resend
# From the Resend dashboard, after verifying the domain (SPF + DKIM DNS records).
EMAIL_API_KEY=
# A sender on the VERIFIED domain, e.g. "GREENLIGHTHOUSE <noreply@greenlighthouse.net>"
EMAIL_FROM=
# The inbox that receives new-RFQ notifications, e.g. sales@greenlighthouse.net.
# (Admin → Settings can override it once the site is up.)
RFQ_NOTIFY_TO=

# --- Leads store region (Story 5.3) — leave EMPTY for one database ---
# See docs/data-residency.md. If set, it must be reachable from inside the containers.
LEADS_DATABASE_URL=

# --- Analytics (Story 5.8) — BUILD-TIME; leave BOTH empty for "off" ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=
PLAUSIBLE_HOST=

# --- Backups (restic → Hetzner Storage Box over SFTP) ---
# With the SSH config described in docs/deploy.md ("Backups"), e.g.:
#   RESTIC_REPOSITORY=sftp:storagebox:glh-restic
RESTIC_REPOSITORY=
# Encrypts every snapshot. LOSE IT AND THE BACKUPS ARE UNREADABLE — store it in your
# password manager, separately from the server.
RESTIC_PASSWORD=
# cron, in the container's timezone (UTC unless TZ is set).
BACKUP_SCHEDULE=15 3 * * *
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Run one backup when the container starts (validates the whole chain on deploy).
BACKUP_ON_START=true

# GREENLIGHTHOUSE — PRODUCTION environment (docker-compose.prod.yml). Runbook: docs/deploy.md
#
#   cp .env.production.example .env      # ON THE SERVER, in the repo directory; never committed
#   chmod 600 .env
#
# It is named `.env` on the server so that a bare `docker compose …` reads it AND
# picks up COMPOSE_FILE below — which makes the dev docker-compose.yml (published
# database ports, dev passwords) impossible to start there by accident.
#
# Generate every secret ON THE SERVER with:   openssl rand -hex 32
# Hex on purpose: POSTGRES_PASSWORD is embedded in a connection URL and must never
# need URL-escaping. Never paste these values into chat, tickets or git. Keep a
# copy of the finished file in your password manager: without it (above all
# RESTIC_PASSWORD) a dead server cannot be rebuilt from the backups.
#
# Internal addresses (Postgres, Redis, ClamAV) are set by the compose file — do
# NOT add DATABASE_URL / REDIS_URL / CLAMAV_HOST here. Values marked REQUIRED make
# `docker compose up` fail by name while they are empty.

# --- Compose ---
COMPOSE_FILE=docker-compose.prod.yml
COMPOSE_PROJECT_NAME=glh-prod
# `local-s3` runs the file store ON THIS SERVER (the free-tier setup). Delete this
# line only if you use a managed store instead (see "Object storage" below).
COMPOSE_PROFILES=local-s3

# --- Domain & TLS (Caddy) ---
# REQUIRED. The CANONICAL host. Must match exactly what visitors see: canonical/
# hreflang/sitemap URLs are built from it, and the RFQ form rejects other origins.
SITE_DOMAIN=www.greenlighthouse.net
# REQUIRED. Redirected (301) to the canonical host.
APEX_DOMAIN=greenlighthouse.net
# REQUIRED. Let's Encrypt account / expiry notices.
ACME_EMAIL=

# Search engines stay OUT until GO-LIVE (owner-actions §0: content + legal/translation
# reviews done). Anything but "true" ⇒ robots.txt disallows everything.
SITE_ALLOW_INDEXING=false

# --- Secrets (openssl rand -hex 32 — each a DIFFERENT value) ---
# REQUIRED. ⚠️ Used only when the database is FIRST created; changing it later
# here does not change the database's password (docs/deploy.md, "Troubleshooting").
POSTGRES_PASSWORD=
# REQUIRED. Admin session signing key (>= 32 bytes, or the app refuses to sign/verify).
AUTH_SECRET=
# REQUIRED. Guards POST /api/revalidate.
REVALIDATE_SECRET=

# --- Object storage (uploaded files) ---
# ON THIS SERVER (with COMPOSE_PROFILES=local-s3 above) — keep these four as they are:
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=greenlighthouse-media
# REQUIRED. The store's own key pair — generate both here:
#   S3_ACCESS_KEY_ID:      openssl rand -hex 16
#   S3_SECRET_ACCESS_KEY:  openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
#
# MANAGED instead (e.g. Hetzner Object Storage): delete the COMPOSE_PROFILES line,
# create a PRIVATE bucket in the provider's console, and set
#   S3_ENDPOINT=https://fsn1.your-objectstorage.com   S3_REGION=fsn1
#   S3_FORCE_PATH_STYLE=false   S3_BUCKET=<that bucket>   + the provider's key pair.

# --- Email (Resend) ---
# The production worker REFUSES TO START on a non-delivering transport.
EMAIL_PROVIDER=resend
# REQUIRED. From the Resend dashboard, after verifying the domain (SPF + DKIM DNS records).
EMAIL_API_KEY=
# REQUIRED. A sender on the VERIFIED domain, e.g. "GREENLIGHTHOUSE <noreply@greenlighthouse.net>"
EMAIL_FROM=
# REQUIRED. The inbox that receives new-RFQ notifications, e.g. sales@greenlighthouse.net.
# (Admin → Settings can override it once the site is up.)
RFQ_NOTIFY_TO=

# --- Leads store region (Story 5.3) — leave EMPTY for one database ---
# See docs/data-residency.md. If set, it must be reachable from inside the containers.
LEADS_DATABASE_URL=

# --- Analytics (Story 5.8) — BUILD-TIME; leave BOTH empty for "off" ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=
PLAUSIBLE_HOST=

# --- Backups (restic, OFF this server) ---
# REQUIRED. Backblaze B2 (free up to 10 GB; docs/deploy.md step 1), as an S3 URL —
# the endpoint is shown on the bucket's page in B2:
#   RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/<your-b2-bucket>
# (Or a Hetzner Storage Box over SFTP: sftp:storagebox:glh-restic — see the runbook.)
RESTIC_REPOSITORY=
# For B2: the application key restricted to that bucket (keyID + applicationKey).
# Leave empty for a Storage Box.
RESTIC_S3_ACCESS_KEY_ID=
RESTIC_S3_SECRET_ACCESS_KEY=
# For B2: the region in the endpoint above, e.g. eu-central-003.
RESTIC_S3_REGION=
# REQUIRED. Encrypts every snapshot. LOSE IT AND THE BACKUPS ARE UNREADABLE — store
# it in your password manager, separately from the server.
RESTIC_PASSWORD=
# Strongly recommended: a dead-man's-switch URL (e.g. a free healthchecks.io
# check, period 1 day, grace 2 hours). Every successful backup pings it; you get an
# email when the pings stop. Empty = nobody is told when backups stop working.
BACKUP_HEARTBEAT_URL=
# cron, in the container's timezone (UTC unless TZ is set).
BACKUP_SCHEDULE=15 3 * * *
# The newest N snapshots are always kept, whatever their dates (a bad run cannot
# erase that day's earlier good ones); then one per day / week / month.
BACKUP_KEEP_LAST=7
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Run one backup when the container starts (validates the whole chain on deploy).
BACKUP_ON_START=true

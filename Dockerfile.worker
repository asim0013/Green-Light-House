# syntax=docker/dockerfile:1
# GREENLIGHTHOUSE BullMQ worker — RFQ email send + retry (Story 3.3).
# NOT malware scanning: the ClamAV scan runs synchronously inside the RFQ request
# handler (Story 3.7b), so this container never contacts clamd. The Story 1.1
# stub entry it replaced also promised a second `email.send` queue that never
# existed; there is ONE queue with one job name.

FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# ⚠️ WITHOUT THIS THE CONTAINER CRASH-LOOPS ON BOOT. There is no `postinstall`
# script, and at `npm ci` time only package.json and the lockfile exist — the
# Prisma schema has not been copied yet — so nothing has ever generated the
# client. `worker/index.ts` imports `@/lib/db` on its first line, which throws
# "@prisma/client did not initialize yet" before a single job is read. The
# generate must run AFTER `COPY . .`, because it reads prisma/schema.prisma.
RUN npx prisma generate
ENV NODE_ENV=production
# `--env-file` is node's, not tsx's: MEASURED during Story 3.3, `npx tsx` does
# NOT load `.env` while `node --env-file=.env --import tsx` does. In compose the
# variables arrive through `env_file:`/`environment:` anyway, so this form is
# what keeps the container and `npm run worker` identical.
CMD ["node", "--import", "tsx", "worker/index.ts"]

# GREENLIGHTHOUSE — production edge (docker-compose.prod.yml `caddy` service).
#
# Caddy is the ONE trusted edge in front of the app:
#  - obtains + renews the TLS certificates automatically (Let's Encrypt), for
#    both names below, as soon as DNS points at this server;
#  - redirects HTTP → HTTPS (automatic) — the "HTTPS enforced" half that the
#    app's HSTS header cannot do (Story 5.7, docs/security-review.md);
#  - 301s the bare domain to the canonical www host. The canonical host MUST equal
#    SITE_URL: canonical/hreflang/sitemap URLs are built from it, and the RFQ
#    endpoint rejects browser POSTs whose Origin differs from it;
#  - sets X-Forwarded-For to the real client IP, which the RFQ rate limiter reads
#    (it trusts the rightmost entry only — Story 3.7a; exactly one edge, this one).
#
# Domains come from the environment (the server-side .env): SITE_DOMAIN (canonical,
# e.g. www.greenlighthouse.net) and APEX_DOMAIN (e.g. greenlighthouse.net).

{
	email {$ACME_EMAIL}
}

{$APEX_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Largest legitimate upload is an admin video (50 MB, src/server/admin/media);
	# the app enforces each per-type limit itself. This only stops absurd bodies at
	# the edge.
	request_body {
		max_size 64MB
	}

	reverse_proxy app:3000

	log {
		output stdout
		format console
	}
}

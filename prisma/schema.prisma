// GREENLIGHTHOUSE — Product Intelligence Database (PID)
// Story 1.2. Relational source of truth for catalog/search/projects.
// Conventions (CLAUDE.md / architecture): models PascalCase singular, @@map to
// snake_case plural; columns snake_case via @map; PK id; FK <entity>_id;
// created_at/updated_at. Every human-readable field lives in a *_translations
// table keyed (<entity>_id, locale). NO price anywhere (FR2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  en
  tr
  ru
}

enum PublishStatus {
  draft
  published
}

enum DocumentType {
  datasheet
  certificate
  catalog
  manual
  drawing
}

enum LeadStatus {
  new
  in_review
  quoted
  closed
}

/// Where an inquiry came from. `search` and `service` are placed BEFORE `direct`
/// so `direct` stays the fallthrough: it means "no doorway context", not "other".
///
/// ⚠️ THE PHYSICAL ORDER IN POSTGRES DID NOT MATCH THIS UNTIL 2026-08-25. The
/// migration that added the values used bare `ALTER TYPE ... ADD VALUE`, which
/// APPENDS — the clause needed is `ADD VALUE 'x' BEFORE 'direct'` — so `direct`
/// sat 4th in `pg_enum` while this comment said otherwise. **Prisma cannot see
/// this**: `migrate status` and a datamodel diff both reported no drift, so every
/// gate was blind to it. Corrected by `20260825190000_leadsource_enum_order`
/// (create new type + swap, the only route Postgres offers) and now asserted in
/// `repository.integration.test.ts` — because nothing else can catch it.
/// `search` is the `/rfq?q=` doorway Story 2.5 shipped; `service` is the services
/// page CTA. Both were reachable in shipped code before this enum could name them.
enum LeadSource {
  project
  product
  industry
  search
  service
  direct
}

/// Attachment scan lifecycle (FR32a — "quarantined/non-public until it passes").
/// Nullable on `Lead`: null means no attachment, NOT "unscanned". Story 3.7b owns
/// the transitions; Story 3.0 only gives the state machine somewhere to live.
enum AttachmentScanStatus {
  pending
  clean
  infected
  failed
}

enum MatchType {
  direct
  variant
  alternative
}

model Industry {
  id           String                @id @default(cuid())
  slug         String                @unique
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  translations IndustryTranslation[]
  products     ProductIndustry[]
  documents    DocumentIndustry[]
  services     ServiceIndustry[]
  projects     Project[]

  @@map("industries")
}

model IndustryTranslation {
  id          String   @id @default(cuid())
  industryId  String   @map("industry_id")
  locale      Locale
  name        String
  description String?
  industry    Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([industryId, locale])
  @@map("industry_translations")
}

model Manufacturer {
  id           String                    @id @default(cuid())
  slug         String                    @unique
  logoUrl      String?                   @map("logo_url")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  translations ManufacturerTranslation[]
  series       Series[]
  products     Product[]
  documents    Document[]

  @@map("manufacturers")
}

model ManufacturerTranslation {
  id             String       @id @default(cuid())
  manufacturerId String       @map("manufacturer_id")
  locale         Locale
  name           String
  description    String?
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@unique([manufacturerId, locale])
  @@map("manufacturer_translations")
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  parentId     String?               @map("parent_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  parent       Category?             @relation("CategoryChildren", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryChildren")
  translations CategoryTranslation[]
  products     Product[]

  @@map("categories")
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String   @map("category_id")
  locale     Locale
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Series {
  id             String              @id @default(cuid())
  slug           String              @unique
  manufacturerId String              @map("manufacturer_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  manufacturer   Manufacturer        @relation(fields: [manufacturerId], references: [id])
  translations   SeriesTranslation[]
  products       Product[]

  @@map("series")
}

model SeriesTranslation {
  id       String @id @default(cuid())
  seriesId String @map("series_id")
  locale   Locale
  name     String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, locale])
  @@map("series_translations")
}

model Product {
  id             String        @id @default(cuid())
  model          String
  slug           String        @unique
  manufacturerId String        @map("manufacturer_id")
  categoryId     String        @map("category_id")
  seriesId       String?       @map("series_id")
  status         PublishStatus @default(draft)
  // Typed technical spec as key/values (JSONB) — flexible for sparse launch + import (Q2).
  attributes     Json          @default("{}")
  media          Json          @default("[]")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  // NO price field — GLH never exposes prices (FR2).

  manufacturer    Manufacturer             @relation(fields: [manufacturerId], references: [id])
  category        Category                 @relation(fields: [categoryId], references: [id])
  series          Series?                  @relation(fields: [seriesId], references: [id])
  translations    ProductTranslation[]
  industries      ProductIndustry[]
  documents       Document[]
  bomLines        ProjectBomLine[]
  accessories     AccessoryCompatibility[] @relation("ProductAccessories")
  accessoryOf     AccessoryCompatibility[] @relation("AccessoryProduct")
  crossReferences CrossReference[]

  @@map("products")
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String  @map("product_id")
  locale      Locale
  name        String
  description String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_translations")
}

model Document {
  id             String       @id @default(cuid())
  slug           String       @unique
  type           DocumentType
  // file_key points at the CURRENT version's stored object; the public path (slug)
  // is stable across replacements (FR25a).
  fileKey        String       @map("file_key")
  mime           String?
  sizeBytes      Int?         @map("size_bytes")
  version        Int          @default(1)
  isPublic       Boolean      @default(true) @map("is_public")
  productId      String?      @map("product_id")
  manufacturerId String?      @map("manufacturer_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  product      Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  manufacturer Manufacturer?         @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  translations DocumentTranslation[]
  industries   DocumentIndustry[]

  @@map("documents")
}

model DocumentTranslation {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  locale     Locale
  title      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, locale])
  @@map("document_translations")
}

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  industryId    String?       @map("industry_id")
  status        PublishStatus @default(draft)
  media         Json          @default("[]")
  deliveredAt   DateTime?     @map("delivered_at")
  /// Facts-card LEAD TIME. Stored as an integer and rendered through an ICU
  /// plural, never as prose: the canvas spells it "six weeks" in one place and
  /// "6 wk" in another, and no locale can derive a spelled-out numeral from an
  /// integer (Intl has no spell-out). One number, one formatter.
  leadTimeWeeks Int?          @map("lead_time_weeks")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  industry     Industry?            @relation(fields: [industryId], references: [id], onDelete: SetNull)
  translations ProjectTranslation[]
  bomLines     ProjectBomLine[]

  @@map("projects")
}

model ProjectTranslation {
  id          String  @id @default(cuid())
  projectId   String  @map("project_id")
  locale      Locale
  title       String
  description String?
  outcome     String?
  /// Facts-card SCOPE — a short capability phrase ("Fire & gas detection +
  /// suppression"), NOT the narrative. `description` remains the narrative body.
  scope       String?
  /// Facts-card LOCATION. Translated because place names are
  /// ("Marmara, Türkiye" / "Мармара, Турция").
  location    String?
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@map("project_translations")
}

model Service {
  id           String               @id @default(cuid())
  slug         String               @unique
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  translations ServiceTranslation[]
  industries   ServiceIndustry[]

  @@map("services")
}

model ServiceTranslation {
  id          String  @id @default(cuid())
  serviceId   String  @map("service_id")
  locale      Locale
  name        String
  description String?
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@map("service_translations")
}

/// The site-wide response process shown in place of prices (Story 3.5 —
/// FR30/FR34a/FR38).
///
/// A SINGLETON, addressed by a stable `key` rather than by "the first row":
/// the read must be deterministic, and Story 4.8's editor needs something to
/// address. One process carries a per-locale kicker + summary and exactly three
/// ordered steps.
///
/// ⚠️ THE SUMMARY IS NOT DECORATION. Seven of the nine consuming render sites draw
/// a one-line sentence, not the stepper, and that sentence is NOT composable
/// from the step data — the EN steps say "Spec + proposal" where the shipped
/// sentence says "specced proposal", and TR inverts the order entirely. Without
/// a stored summary those seven surfaces cannot be served from this model at all.
model SlaProcess {
  id           String                  @id @default(cuid())
  key          String                  @unique
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  translations SlaProcessTranslation[]
  steps        SlaStep[]

  @@map("sla_processes")
}

model SlaProcessTranslation {
  id        String     @id @default(cuid())
  processId String     @map("process_id")
  locale    Locale
  /// The stepper heading, previously the `Rfq.slaKicker` message key.
  kicker    String
  /// The one-line trust sentence, previously the four duplicated `sla` keys.
  summary   String
  process   SlaProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([processId, locale])
  @@map("sla_process_translations")
}

/// One step of the process. THREE per process, ordered by `sort`.
///
/// ⚠️ `sort` IS A NEW PRECEDENT. No other model in this schema has an ordering
/// column — `Service` orders by slug and the only other `sort` in the repo lives
/// inside a JSON blob. Slug-ordering cannot express 24h -> 3 days -> arrow, so an
/// explicit integer is the only option consistent with these conventions. Story
/// 3.1b's BOM ordering should follow this shape.
/// ⚠️ `@@unique([processId, sort])` IS DEFERRABLE IN THE DATABASE AND PRISMA
/// CANNOT SEE IT. Migration `20260906120000_sla_steps_deferrable_sort` dropped
/// the plain unique index and added `UNIQUE (process_id, sort) DEFERRABLE
/// INITIALLY IMMEDIATE`, so an in-place reorder can opt in with
/// `SET CONSTRAINTS sla_steps_process_id_sort_key DEFERRED` for one transaction.
/// There is no Prisma attribute for deferrability, so the line below is
/// deliberately unchanged and `migrate diff` correctly reports no drift.
///
/// ⛔ TWO CONSEQUENCES THE MIGRATION'S OWN DOCSTRING GETS WRONG — READ THESE
/// BEFORE COPYING THIS SHAPE (Story 3.1b is told by that file to copy it for
/// project BOM lines). Both re-measured on a throwaway during the 3.8 review:
///
///  1. IT IS NOT BEHAVIOUR-PRESERVING. The migration says "every existing write
///     keeps its current fail-fast behaviour". False: a deferrable constraint is
///     checked at END OF STATEMENT rather than per row even in IMMEDIATE mode.
///     `UPDATE sla_steps SET sort = sort + 1 WHERE process_id = 'p'` ERRORED
///     under the old index and now SUCCEEDS with no `SET CONSTRAINTS` at all.
///     Uniqueness is still enforced — a statement that ENDS duplicated still
///     fails — so the loosening is in the safe direction, but it is a change.
///     The two-STATEMENT swap does still fail without deferral, so the
///     `SET CONSTRAINTS` opt-in is genuinely required for the ORM path.
///
///  2. ⛔ IT CANNOT BE AN `ON CONFLICT` ARBITER. Postgres refuses a deferrable
///     constraint there: `ON CONFLICT does not support deferrable unique
///     constraints/exclusion constraints as arbiters` (SQLSTATE 55000). So
///     `slaStep.upsert({ where: { processId_sort }, update: { <non-empty> } })`
///     and `createMany({ skipDuplicates: true })` both THROW on this table.
///     `prisma/seed.ts` survives only because its `update: {}` is EMPTY, which
///     takes Prisma off the native-upsert path onto SELECT-then-INSERT — add one
///     field to that `update` and the seed breaks. `upsert({ where: { id } })`
///     is unaffected.
///
///  3. Minor, but it misleads anyone following the worked example: the migration's
///     illustrative transcript puts its `-- ERROR: duplicate key` annotation on
///     the SECOND `UPDATE`. Measured: the FIRST one collides
///     (`SET sort=2 WHERE id='s1'` hits the row already holding sort=2), so the
///     comment implies statement 1 survives when it does not. Commit `2a7a35a`'s
///     message paraphrases the same pair with `WHERE sort=` predicates, which
///     makes its "MEASURED ... not argued" transcript unreproducible as written.
model SlaStep {
  id           String               @id @default(cuid())
  processId    String               @map("process_id")
  sort         Int
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  process      SlaProcess           @relation(fields: [processId], references: [id], onDelete: Cascade)
  translations SlaStepTranslation[]

  @@unique([processId, sort])
  @@map("sla_steps")
}

model SlaStepTranslation {
  id          String  @id @default(cuid())
  stepId      String  @map("step_id")
  locale      Locale
  /// TRANSLATED, not a structural token: EN "24h", TR "24 saat", RU "24 ч".
  /// Step three's badge is a literal arrow and is the one locale-invariant value.
  badge       String
  title       String
  description String
  step        SlaStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, locale])
  @@map("sla_step_translations")
}

// Written now so the model exists; the RFQ that creates leads is Epic 3,
// the admin that reads/deletes them is Epic 4. Not built here.
model Lead {
  id String @id @default(cuid())

  /// The human-quotable reference the sender sees on screen and both emails cite.
  /// Story 3.0 — DB-side, from `lead_reference_seq` (hand-written in the migration;
  /// Prisma cannot author CREATE SEQUENCE).
  ///
  /// NO `lpad`. The epics AC proposed `lpad(n::text, 4, '0')`; Postgres `lpad`
  /// TRUNCATES to the target width rather than only padding, so at sequence value
  /// 10000 it emits `GLH-RFQ-1000` and every later value collides. Proven in a
  /// scratch database: 9999 -> GLH-RFQ-9999, 10000 -> GLH-RFQ-1000, then 10001 and
  /// 10002 both failed with `duplicate key ... (GLH-RFQ-1000) already exists`. On a
  /// live endpoint that is a hard 500 on the 10,001st inquiry. The sequence starts
  /// at 2000, so references are four digits until they naturally become five.
  ///
  /// The default string below is POSTGRES'S OWN CANONICAL FORM, read back with
  /// `pg_get_expr`. Prisma 6 compares `dbgenerated` strings LITERALLY: a
  /// semantically identical but differently-spelled expression makes `migrate dev`
  /// propose a spurious `ALTER COLUMN ... SET DEFAULT` on every run, forever, and
  /// the remedy for that drift is a reset — which is consent-gated here.
  ///
  /// Gaps are CORRECT: `nextval` is non-transactional, so a rolled-back insert
  /// burns its value. Never diagnose a gap as a lost lead, and never assert
  /// contiguity in a test.
  reference String @unique @default(dbgenerated("('GLH-RFQ-'::text || (nextval('lead_reference_seq'::regclass))::text)"))

  /// Industry SLUG, resolved server-side — never a translated label. `Lead` has no
  /// FK to `Industry` by design (a lead must survive the industry being renamed or
  /// removed), so the slug is the only stable join key Story 4.7 can filter on.
  industry String?

  /// Tagged-union array; see `src/server/rfq/contracts.ts` for the frozen shape.
  /// The discriminator is an explicit `kind`, never the presence of a field.
  equipment      Json    @default("[]")
  projectDetails String? @map("project_details")
  quantities     String?

  /// Free text, constrained by zod at the boundary rather than by a Postgres enum:
  /// the option set is unspecified (the mock offers one set, no FR fixes it), so it
  /// must be changeable without a migration.
  timeline String?

  company String
  name    String
  email   String
  phone   String?
  country String?
  locale  Locale?

  /// Attachment metadata. Story 3.2 captures nothing here (attachment capture moved
  /// to Story 3.7b in the planning review); these exist so 3.7b adds no migration.
  attachmentKey        String?               @map("attachment_key")
  attachmentName       String?               @map("attachment_name")
  attachmentMime       String?               @map("attachment_mime")
  attachmentSizeBytes  Int?                  @map("attachment_size_bytes")
  attachmentScanStatus AttachmentScanStatus? @map("attachment_scan_status")
  attachmentScannedAt  DateTime?             @map("attachment_scanned_at")

  consent   Boolean   @default(false)
  consentAt DateTime? @map("consent_at")

  /// Which privacy-policy version the sender was shown (FR44). Nullable because
  /// leads created before the policy is versioned have no honest answer.
  consentVersion String? @map("consent_version")

  status         LeadStatus @default(new)
  source         LeadSource @default(direct)
  prefillContext Json       @default("{}") @map("prefill_context")

  /// Send state (Story 3.3). Nullable throughout: null means "not yet", never
  /// "failed" — `deliveryFailureReason` carries terminal failure so a null
  /// timestamp is never ambiguous.
  notifiedAt            DateTime? @map("notified_at")
  confirmationSentAt    DateTime? @map("confirmation_sent_at")
  deliveryFailureReason String?   @map("delivery_failure_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Story 4.7's leads list sorts newest-first and filters by status.
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("leads")
}

// --- Many-to-many join models ---

model ProductIndustry {
  productId  String   @map("product_id")
  industryId String   @map("industry_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([productId, industryId])
  @@map("product_industries")
}

model DocumentIndustry {
  documentId String   @map("document_id")
  industryId String   @map("industry_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([documentId, industryId])
  @@map("document_industries")
}

model ServiceIndustry {
  serviceId  String   @map("service_id")
  industryId String   @map("industry_id")
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([serviceId, industryId])
  @@map("service_industries")
}

/// Scope-of-supply BOM line (Story 3.1b, AC2) — REPLACES the bare
/// `ProjectProduct` join, which carried no quantity and no ordering and had two
/// rows and zero foreign-key dependants when this landed.
///
/// ⛔ THE LINE IS SELF-SUFFICIENT; THE PRODUCT JOIN ONLY ENRICHES IT. `model` is
/// NOT NULL and is the display value for every line. `productId` is OPTIONAL
/// because one designed row is not a catalog product at all ("Clean-agent
/// suppression skid / FM-200 skid / — / 3"), and the AC exists to prove that row
/// renders. When a PUBLISHED product is linked it supplies the MANUFACTURER and
/// the equipment-card subset; a draft or absent product is treated identically —
/// the line shows its own `model` and an em-dash manufacturer, leaking nothing.
///
/// ⛔ DO NOT FILTER THESE LINES IN THE QUERY. `where: { product: { status:
/// "published" } }` still TYPECHECKS against a nullable relation — Prisma binds
/// the bare shorthand to `is:`, an INNER JOIN — so a `product_id IS NULL` row is
/// silently excluded and the derived footer renders "4 line items / 314 units"
/// instead of 5 / 317, with no error and no failing test. Filter at the MAPPER,
/// which has three different rules for its three consumers (see
/// `repositories/project.ts`).
///
/// ⛔ `onDelete: SetNull` ON THE PRODUCT, NOT `Cascade`. `ProjectProduct` carried
/// `Cascade`, which was right for a join row and is wrong here: with a nullable
/// `productId`, cascading would let deleting a catalog product silently DELETE a
/// delivered project's BOM line and move the footer's totals.
///
/// The ordering index is deliberately NON-unique. A compound unique on an
/// ordering column is the shape `sla_steps` had to make DEFERRABLE, and a
/// deferrable unique cannot serve as an `ON CONFLICT` arbiter (SQLSTATE 55000) —
/// see the doc block on `model SlaStep`. The cost is that there is no addressable
/// key for `upsert`, so the seed writes these delete-then-create per project.
model ProjectBomLine {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  productId String?  @map("product_id")
  /// The display MODEL for every line — free text for a non-catalog line, and
  /// the stored value even when a product is linked, so the line never depends
  /// on the join to render.
  model     String
  quantity  Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product      Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  translations ProjectBomLineTranslation[]

  @@index([projectId, sortOrder])
  @@map("project_bom_lines")
}

/// The BOM's CATEGORY column — authored editorial text, per line, translated.
///
/// ⚠️ IT IS NOT THE PRODUCT'S CATEGORY NAME, and that was counted rather than
/// assumed: ZERO of the canvas's five CATEGORY cells match the seeded category
/// name of the product on that row ("Triple-IR flame detection" vs "Flame
/// detectors", and so on). Wiring this column to `product.category` yields a
/// table that renders plausibly and matches no row of the design.
model ProjectBomLineTranslation {
  id     String         @id @default(cuid())
  lineId String         @map("line_id")
  locale Locale
  label  String
  line   ProjectBomLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, locale])
  @@map("project_bom_line_translations")
}

// --- Phased relations: tables created now, populated later (FR18 / FR6.3) ---

model AccessoryCompatibility {
  productId          String  @map("product_id")
  accessoryProductId String  @map("accessory_product_id")
  product            Product @relation("ProductAccessories", fields: [productId], references: [id], onDelete: Cascade)
  accessory          Product @relation("AccessoryProduct", fields: [accessoryProductId], references: [id], onDelete: Cascade)

  @@id([productId, accessoryProductId])
  @@map("accessory_compatibilities")
}

model CrossReference {
  id            String    @id @default(cuid())
  productId     String    @map("product_id")
  externalBrand String    @map("external_brand")
  externalModel String    @map("external_model")
  matchType     MatchType @map("match_type")
  createdAt     DateTime  @default(now()) @map("created_at")
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([externalBrand, externalModel, productId])
  @@map("cross_references")
}

/// SITE-WIDE OPERATIONAL SETTINGS (Story 4.0 — the foundation for Stories 4.4/4.8).
///
/// ⚠️ THIS TABLE HAS NO READER YET, ON PURPOSE. Story 4.0 lands the model, the
/// migration and the seed only; the public surfaces still read
/// `src/config/contact.ts`, `src/config/site.ts` and the `RFQ_NOTIFY_TO` env var.
/// Story 4.8 adds the editor and repoints those surfaces (a form + `revalidateTag`).
/// Mirrors how Story 3.0 froze Epic 3's contracts before its feature stories.
///
/// ⚠️ VALUES ONLY, NEVER COPY — and therefore NO translation table. This mirrors
/// `src/config/contact.ts`'s core rule ("values live here, labels live in
/// `messages/`"): a phone number, an email, a postal address, a tax number and a
/// notification recipient are the same in every language. The one translated
/// place-name (İstanbul/Стамбул) deliberately stays in `messages/`, not here.
///
/// ⚠️ `null` IS THE ONLY "NOT SUPPLIED" MARKER — same contract as `contact.ts`.
/// No sentinel strings, no placeholders. A field is configured iff non-null and
/// non-blank; the trim/blank decision stays with `isSupplied`/`suppliedValue` when
/// Story 4.8 repoints the readers.
///
/// ⛔ THE APPROVAL GATES ARE NOT HERE. `CONTACT.approvals.legalReviewed` /
/// `translationsReviewed` stay in `src/config/contact.ts` (code), because their
/// audit trail is the COMMIT that flips them (`contact.ts:57-60`). A togglable DB
/// column would re-hide them and let an admin self-approve. This table carries the
/// VALUES; the two human gates remain code-flipped.
///
/// SINGLETON: exactly one row, keyed by the fixed id `"singleton"`. The seed
/// upserts it; Story 4.8's reader targets the same id. Do not create a second row.
model SiteSettings {
  id              String   @id @default("singleton")
  contactEmail    String?  @map("contact_email")
  contactAddress  String?  @map("contact_address")
  legalName       String?  @map("legal_name")
  tradeRegistryNo String?  @map("trade_registry_no")
  taxOffice       String?  @map("tax_office")
  taxNo           String?  @map("tax_no")
  mersisNo        String?  @map("mersis_no")
  phone           String?
  phoneDisplay    String?  @map("phone_display")
  rfqNotifyTo     String?  @map("rfq_notify_to")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
